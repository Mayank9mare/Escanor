# Copy to .env (in the project root or ~/.escanor/.env) and fill in what you use.
# Exported shell variables win over this file. Never commit .env.

# Claude (default model: Haiku). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: /model gpt
OPENAI_API_KEY=

# Optional: /model gemini. Free tier lets Google use prompts to improve its
# products, so don't send it anything confidential. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: /model local. Only needed if Ollama isn't on localhost:11434.
OLLAMA_BASE_URL=
